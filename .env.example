# Supabase Configuration
# ========================
# Get these values from: https://app.supabase.com
# 
# Steps to find them:
# 1. Go to your project dashboard
# 2. Click Settings (gear icon) → API
# 3. Copy the three values below

# Your Supabase Project URL
# Format: https://your-project-id.supabase.co
# This is a PUBLIC value (safe to share, will be in browser)
NEXT_PUBLIC_SUPABASE_URL=https://irgfuhhepvzixhprdlsn.supabase.co

# Your Supabase Anon Key (public/client key)
# ⚠️ IMPORTANT: This repo pins @supabase/ssr@0.12.7 and @supabase/supabase-js@2.43.0,
#    which do NOT support the new `sb_publishable_...` key format introduced in 2025.
#    Use the legacy `eyJhbG...` anon key from Supabase Dashboard → Settings → API,
#    or upgrade deps: npm i @supabase/ssr@latest @supabase/supabase-js@latest
#    then you may use `sb_publishable_...`.
# This is a PUBLIC value (safe to share, will be in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
# If you have upgraded deps, you may use instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_GQv2l2VrLAnEuFuof1bjTg_ZOSgyd1X

# Your Supabase Service Role Key (secret/server key)
# Legacy format: eyJhbG...   New format (if upgraded): sb_secret_...
# ⚠️ THIS IS SECRET - NEVER share or commit this to git!
# ⚠️ Only use this on the server-side (backend/API routes)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: Google OAuth (if using Google login)
# Configure in Supabase Auth settings instead of here

